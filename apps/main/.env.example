# 환경변수 예시 — 실제 값은 .env.local 에 넣으세요 (깃에 커밋되지 않습니다)

# 로컬 화면 확인용 관리자 우회. 정확한 로컬 자리표시자 + 서버 키 없음에서만 동작.
# 실제 Supabase를 연결하거나 배포할 때는 반드시 0.
LOCAL_ADMIN_BYPASS=0

# 같은 Supabase 프로젝트에서 발급받은 값만 함께 사용하세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이거나 Git에 올리지 마세요.
SUPABASE_SECRET_KEY=
# release:check용. 대시보드에서 대상 프로젝트를 확인한 뒤 지정 (공개 식별자).
RELEASE_EXPECTED_SUPABASE_REF=

# 공공데이터포털(data.go.kr) 인증키 — 1365 봉사 모집 정보 조회에 사용
# 발급: data.go.kr 로그인 → "행정안전부_봉사참여정보서비스" 활용신청 → 마이페이지에서 인증키 복사
# Encoding/Decoding 키 어느 쪽을 넣어도 동작합니다.
DATA_GO_KR_SERVICE_KEY=

# 1365 목록 오퍼레이션 (기본값: getVltrSearchWordList)
PORTAL_1365_OPERATION=

# VMS 공개 모집 목록 수집을 끄려면 1 로 설정
DISABLE_VMS=

# ---------- 공지 푸시 알림 (웹 푸시) ----------
# VAPID 키 쌍 생성:  npx web-push generate-vapid-keys
# 공개키는 클라이언트 번들에 들어가므로 NEXT_PUBLIC_ 접두사가 필요합니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 푸시 서비스에 알려줄 연락처 (기본값: mailto:haerangsariwoo@hansung.ac.kr)
VAPID_CONTACT=
